{
  "name": "dsh-memory",
  "version": "0.1.0",
  "description": "Modular memory layers for DeepSeek Harness: archive (raw streams) / cards (engram-backed) / recall (query for the agent). 记忆系统按层拆成可插拔模块——档案层存原始流水、卡片层存提炼结果、检索层给 agent 查询，层之间只通过接口通信。",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/",
    "lint": "node --check src/index.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "engram",
    "archive",
    "recall",
    "记忆",
    "记忆系统"
  ],
  "license": "GPL-2.0-only",
  "engines": {
    "node": ">=22.5"
  },
  "os": [
    "darwin",
    "linux",
    "!win32"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.1 || ^0.2.1-rc.2"
  }
}
